<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Unit tests for the pure logic in ../JumpingSpiders/Logic.
        The test project compiles those source files directly instead of referencing the mod project,
        so the tests need none of the game's DLLs and run anywhere with plain `dotnet test`.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../JumpingSpiders/Logic/**/*.cs" Link="Logic/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

</Project>
