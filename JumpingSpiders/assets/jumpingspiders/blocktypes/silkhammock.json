{
	// The silk hammock jumping spiders sleep in. C# side: Hammock/BlockSilkHammock.cs and Hammock/BlockEntitySilkHammock.cs.
	//
	// Variants are named by the direction from the hammock to the block that holds it:
	//   silkhammock-north / -east / -south / -west   on a wall or tree trunk on that side
	//   silkhammock-up                               hanging under a ceiling or branch
	//   silkhammock-down                             lying on the ground or a block
	// All six use the one model, shapes/block/silkhammock-wall.json, turned per variant (see shapeByType).
	// The C# code reads the direction from the "side" variant group and builds codes as "silkhammock-<side>", so keep
	// "side" the only variant group (or update BlockSilkHammock.GetVariant when adding one).
	code: "silkhammock",
	class: "jumpingspiders.BlockSilkHammock",
	entityClass: "jumpingspiders.SilkHammock",
	variantgroups: [
		{ code: "side", states: ["north", "east", "south", "west", "up", "down"] }
	],
	attributes: {
		// Breaking with shears is this many times faster than by hand or with any other tool (BlockSilkHammock.OnGettingBroken).
		shearsBreakSpeedMultiplier: 5,
		// Blocks above the bottom of the cell: where a sleeping spider's feet are (BlockSilkHammock.GetSleepFeetHeight).
		// Walls and ceiling: the cradle's inner bottom (y 9 of the model). Floor: on the base (y 1 of the model, turned
		// upside down). Where this is above the collision box's top (the ceiling), the spider is lifted up here as it
		// falls asleep; see collisionboxByType below.
		sleepFeetHeightByType: {
			"*-down": 0.0625,
			"*": 0.5625
		}
	},
	// Only the floor variant appears in the creative inventory; placing it picks the variant from the clicked face.
	creativeinventory: { "general": ["*-down"] },
	drawtype: "JSON",
	// The model, in its own frame (1/16 block units): a roof slab at the top of the cell (y 15..16), a back panel
	// against the EAST side (x 15..16), and between them a V-shaped cradle running along X whose inner bottom is at
	// y 9. The opening faces WEST (-X), and a sleeping spider looks out through it.
	// rotateY/rotateX turn the whole model around the centre of the cell (ShapeTesselator in the game client).
	// rotateY 90 takes east to north (+X to -Z), so the back panel ends up against the supporting wall:
	//   east 0, north 90, west 180, south 270; the opening points away from the wall.
	// Ceiling: unrotated, the roof slab under the support, opening west.
	// Floor: rotateX 180 turns it upside down (y and z flip, x stays), so the roof slab becomes a base on the ground,
	// the cradle a tent over it, and the opening still faces west. A rotation, not a mirror, so the faces stay the
	// right way out. Vanilla does the same for ceiling coatings (saltpeter-u).
	// BlockSilkHammock.GetSleepYaw must agree with these: it turns a sleeping spider to face the opening.
	shapeByType: {
		"*-north": { base: "jumpingspiders:block/silkhammock-wall", rotateY: 90 },
		"*-east": { base: "jumpingspiders:block/silkhammock-wall", rotateY: 0 },
		"*-south": { base: "jumpingspiders:block/silkhammock-wall", rotateY: 270 },
		"*-west": { base: "jumpingspiders:block/silkhammock-wall", rotateY: 180 },
		"*-up": { base: "jumpingspiders:block/silkhammock-wall" },
		"*-down": { base: "jumpingspiders:block/silkhammock-wall", rotateX: 180 }
	},
	// Keys are the texture codes used on the model's faces. Placeholders from the vanilla game.
	textures: {
		silk: { base: "game:block/cloth/linen/normal1" },
		// "null" is what VS Model Creator writes on faces that have no texture yet (the cradle panels). Mapping it here
		// draws them with the placeholder linen too. Remove this line once every face of the model has a real texture.
		"null": { base: "game:block/cloth/linen/normal1" }
	},
	// Cloth: no vanilla tool has a mining speed for it, so only the shears bonus above makes a difference.
	blockmaterial: "Cloth",
	// Seconds to break by hand.
	resistance: 1.5,
	lightAbsorption: 0,
	sideopaque: { all: false },
	// Nothing can be attached to a hammock (and it cannot hold another hammock).
	sidesolid: { all: false },
	emitSideAo: { all: false },
	// What a spider lands on. The jump planner (SpiderJumpWorld) and the game's physics both use these boxes.
	// Only these boxes collide: the roof, back panel and cradle sides are drawn but can be passed through.
	// - Walls: a solid slab from the bottom of the cell up to the cradle's inner bottom (9/16), so a spider jumps
	//   straight into the cradle and sleeps where it lands. Solid all the way down so that nothing can walk in
	//   under the cradle. The cell above a wall hammock is usually open, so the jump can come in from above; under
	//   another block it cannot be jumped into (the same 7/16 gap as below), and spiders never build or get one there
	//   because both ask the jump planner first.
	// - Ceiling: a thin floor at the bottom of the cell. With the slab, the block holding the hammock would leave
	//   only 7/16 of head room above it, and no jump arc can enter a gap that low (a 0.4 high spider would have to
	//   fly in level). So the spider lands on this floor, under the cradle, and the sleep task lifts it into the
	//   cradle (to sleepFeetHeight) when it falls asleep and holds it there with its physics paused. It is put back
	//   down on this floor when it wakes, and jumps out from there.
	// - Floor: the base slab, 1/16 thick.
	// The four wall variants share one box, so wild hammock placement (on tree trunks, always a wall variant) can
	// use any wall variant's box (WildHammockSites.EvaluateTrunk). Keep it that way, or make that code read each
	// candidate's variant.
	collisionboxByType: {
		"*-up": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 1 },
		"*-down": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.0625, z2: 1 },
		"*": { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.5625, z2: 1 }
	},
	// What the player's cursor hits: the outline of the model, turned like the shape above. In the model's own frame
	// it spans x 2..16, y 7..16, z 1..15 (1/16 units).
	selectionboxByType: {
		"*-east": { x1: 0.125, y1: 0.4375, z1: 0.0625, x2: 1, y2: 1, z2: 0.9375 },
		"*-north": { x1: 0.0625, y1: 0.4375, z1: 0, x2: 0.9375, y2: 1, z2: 0.875 },
		"*-west": { x1: 0, y1: 0.4375, z1: 0.0625, x2: 0.875, y2: 1, z2: 0.9375 },
		"*-south": { x1: 0.0625, y1: 0.4375, z1: 0.125, x2: 0.9375, y2: 1, z2: 1 },
		"*-up": { x1: 0.125, y1: 0.4375, z1: 0.0625, x2: 1, y2: 1, z2: 0.9375 },
		"*-down": { x1: 0.125, y1: 0, z1: 0.0625, x2: 1, y2: 0.5625, z2: 0.9375 }
	},
	// What breaking it gives: 2 to 4 flax twine (2: 25 %, 3: 50 %, 4: 25 %).
	drops: [
		{ type: "item", code: "game:flaxtwine", quantity: { avg: 3, var: 1 } }
	],
	sounds: {
		place: "game:block/cloth",
		break: "game:block/cloth",
		hit: "game:block/cloth",
		walk: "game:walk/cloth"
	},
	materialDensity: 200,
	combustibleProps: {
		burnTemperature: 400,
		burnDuration: 5
	}
}
