{
	// The adult jumping spider: codes jumpingspiders:jumpingspider-adult-male and jumpingspiders:jumpingspider-adult-female.
	// The baby is in jumpingspider-baby.json (same code "jumpingspider", age "baby"), following the vanilla hare.
	//
	// Domains: always write "game:" for vanilla things and "jumpingspiders:" for ours. Without a prefix, some fields
	// default to the game domain and others to ours (see the research notes), so never leave it out.
	// Every number below is a placeholder to tune by playing.
	//
	// No "spawnconditions": wild spiders are spawned by mod code (Spawning folder), never by the vanilla spawner.
	code: "jumpingspider",
	class: "EntityAgent",
	tags: ["animal", "huntable", "adult", "predator", "habitat-land"],
	// Relative body weight used by vanilla target filters (minTargetWeight / maxTargetWeight) (hare 0.5, fox 6).
	weight: 3,
	variantgroups: [
		{ code: "age", states: ["adult"] },
		{ code: "gender", states: ["male", "female"] }
	],
	// Collision and selection box in blocks. Must fit in one block cell next to a wall so the spider can rest in a
	// hammock: at most 0.95 wide and about 0.8 tall. The model may be larger than this.
	// "ByType" picks a value per variant: the key is matched against the entity code, "*" is the fallback.
	// The male has its real model, about 0.4 blocks tall. The female still uses the placeholder box model.
	hitboxSizeByType: {
		"*-male": { x: 0.8, y: 0.4 },
		"*": { x: 0.8, y: 0.6 }
	},
	deadHitboxSize: { x: 0.8, y: 0.3 },
	// Height of the eyes above the feet, used for line-of-sight checks. Must be inside the hitbox.
	eyeHeightByType: {
		"*-male": 0.3,
		"*": 0.45
	},
	// 0 = no fall damage at all (jumps go up to 6 blocks down). This also lets the vanilla pathfinder plan drops.
	fallDamageMultiplier: 0,
	// The jump model was measured with default physics: do not add attributes.physics here.
	drops: [],
	attributes: {
		// Carcasses of what the spider kills keep only this fraction of their meat (vanilla default for predators: 0.4).
		deathByMultiplier: 0.2,
		// Carcass info text for its victims (vanilla lang key, also used by the fox).
		killedByInfoText: "deadcreature-eaten",
		// What it eats. Only food tags count for basket trap bait, and their weight must be at least 0.6.
		// No foodCategories, so vanilla troughs (grain, vegetables, hay) never attract it.
		creatureDiet: {
			weightedFoodTags: [
				{ weight: 1, code: "meat" }
			]
		},
		// Catchable in the small basket trap: chance to be caught when it takes the bait, and chance to break the trap.
		trappable: {
			"small": { trapChance: 0.5, trapDestroyChance: 0.01 }
		}
	},
	client: {
		renderer: "Shape",
		shape: { base: "jumpingspiders:entity/land/jumpingspider/{gender}" },
		// "skin" is the texture code used in the shape files. Placeholder: a vanilla hare texture.
		// "null" is the code VS Model Creator writes on faces that have no texture yet ("#null"), which is every
		// face of the male model for now. Remove that line once the model has its own texture.
		textures: {
			"skin": { base: "game:entity/animal/mammal/hare/european-{gender}1" },
			"null": { base: "game:entity/animal/mammal/hare/european-{gender}1" }
		},
		behaviors: [
			{ code: "repulseagents" },
			{ code: "controlledphysics", stepHeight: 1.1251 },
			{ code: "interpolateposition" },
			{ code: "floatupwhenstuck", onlyWhenDead: true },
			{ code: "harvestable" },
			// Our behavior on the client only shows the info text (wild/domesticated, hungry/sated, asleep).
			{ code: "jumpingspiders.spider" }
			// "health" is not listed here: the game copies the server's health entry to the client by itself.
		],
		// Animation metas. "code" is what the game and the AI tasks ask for; "animation" is the animation code in the
		// shape file. All codes are lowercase. The game itself plays "hurt" when damaged and "die" on death.
		animations: [
			{ code: "idle", animation: "idle", blendMode: "AddAverage", easeOutSpeed: 4, triggeredBy: { defaultAnim: true } },
			{ code: "walk", animation: "walk" },
			{ code: "run", animation: "run" },
			{ code: "jumpwindup", animation: "jumpwindup", easeInSpeed: 6, easeOutSpeed: 6, blendMode: "Average" },
			{ code: "jump", animation: "jump", blendMode: "Average" },
			{ code: "sleep", animation: "sleep", easeInSpeed: 4, easeOutSpeed: 4, blendMode: "Average" },
			{ code: "hurt", animation: "hurt", animationSpeed: 2, weight: 10, blendMode: "AddAverage" },
			{ code: "die", animation: "die", weight: 10, blendMode: "Average", triggeredBy: { onControls: ["dead"] } }
		]
	},
	server: {
		behaviors: [
			{ code: "repulseagents" },
			{ code: "controlledphysics", stepHeight: 1.1251 },
			// Wild spiders despawn after minSeconds (real seconds) without any player within minPlayerDistance (blocks).
			// No belowLightLevel: unlike vanilla animals, wild spiders also despawn in daylight.
			// Spiders the player caught, placed, bred or fed never despawn: EntityBehaviorJumpingSpider switches this
			// timer off for them.
			{ code: "despawn", minPlayerDistance: 32, minSeconds: 600 },
			{ code: "health", currenthealth: 8, maxhealth: 8 },
			{ code: "deaddecay", hoursToDecay: 96, decayedBlock: "game:carcass-small" },
			{ code: "floatupwhenstuck", onlyWhenDead: true },
			{
				code: "harvestable",
				drops: [
					{ type: "item", code: "game:bushmeat-raw", quantity: { avg: 1, var: 0.5 } },
					{ type: "item", code: "game:flaxtwine", quantity: { avg: 1, var: 0 } }
				]
			},
			{ code: "breathe" },
			{
				// Vanilla breeding, females only. A female gets pregnant when her breeding saturation reaches
				// portionsEatenForMultiply and a male with saturation of at least 1 is within requiresNearbyEntityRange.
				// Saturation only comes from live farm-born prey (EntityBehaviorJumpingSpider), one portion per meal.
				code: "multiply",
				enabledByType: {
					"*-female": true,
					"*": false
				},
				spawnEntityCodes: [ { code: "jumpingspiders:jumpingspider-baby-male" }, { code: "jumpingspiders:jumpingspider-baby-female" } ],
				requiresNearbyEntityCode: "jumpingspiders:jumpingspider-adult-male",
				requiresNearbyEntityRange: 10,
				spawnQuantityMin: 1,
				spawnQuantityMax: 3,
				// Keeps the eat task willing to approach baited traps even when she is pregnant or fed.
				eatAnyway: true,
				portionsEatenForMultiply: 2,
				pregnancyDays: 4,
				multiplyCooldownDaysMin: 3,
				multiplyCooldownDaysMax: 6
			},
			{
				// Vanilla emotion states, set when the spider is hit (durations are in the game's own units, not seconds).
				// Same slot: aggressive (priority 2) wins over flee (priority 1) for wild spiders. maxGeneration 0 means
				// bred spiders never become aggressive, so a hit domesticated spider only flees.
				code: "emotionstates",
				states: [
					{ code: "aggressiveondamage", duration: 30, chance: 1, slot: 0, priority: 2, accumType: "noaccum", maxGeneration: 0 },
					{ code: "fleeondamage", duration: 15, chance: 1, slot: 0, priority: 1, accumType: "max" }
				]
			},
			// Must stay before "taskai": it checks the breeding saturation before the eat task runs in the same tick.
			{ code: "jumpingspiders.spider" },
			{
				code: "taskai",
				aiCreatureType: "LandCreature",
				// Keep this list sorted by descending priority. Every AI tick the game walks it in this order and starts
				// the first task that wants to run; a later task can take over from a running one only when its priority is
				// strictly higher than the running task's priorityForCancel.
				// The jumpingspiders.* tasks are explained in their C# files (AiTasks folder). Every key they read is
				// written out below with the code's default, so all of them can be tuned here. Times are in milliseconds
				// (ms), distances in blocks. Animation codes refer to "animations" above; "" = none. The physical jump
				// ability (how high and far a jump goes) is in ModConfig/jumpingspiders.json instead.
				aitasks: [
					{
						// Attack a player while angry ("aggressiveondamage": a wild spider that was hit, or whose hammock
						// a player broke). Stalks, winds up with front legs raised, leaps and bites.
						code: "jumpingspiders.jumpattack",
						entityCodes: ["player"],
						priority: 3.0,
						whenInEmotionState: "aggressiveondamage",
						// Only whoever caused the anger (the player who hit it or broke its hammock), never a bystander.
						targetEmotionSource: true,
						onlyWhenHungry: false,
						tamingGenerations: 1000,
						seekingRange: 10,
						loseTargetRange: 20,
						pounceRange: 5,
						windUpMinMs: 500,
						windUpMaxMs: 1250,
						leadFactor: 0.5,
						hitReach: 0.4,
						damage: 2,
						damageTier: 0,
						damageType: "PiercingAttack",
						knockbackStrength: 0.5,
						movespeed: 0.03,
						maxApproachMs: 15000,
						repathIntervalMs: 1000,
						pounceCheckIntervalMs: 300,
						searchIntervalMs: 500,
						turnSpeedDegPerSec: 360,
						// Rest between two attacks, a random time between these (ms).
						mincooldown: 1500,
						maxcooldown: 3000,
						windUpAnimation: "jumpwindup",
						jumpAnimation: "jump",
						walkAnimation: "walk"
					},
					{
						// Flee by jumping from whoever hit it ("fleeondamage"; a hit wild spider gets angry instead, so this
						// is mostly the domesticated spider's reaction). No wind-up, no damage.
						code: "jumpingspiders.jumpflee",
						priority: 2.8,
						whenInEmotionState: "fleeondamage",
						fleeFromEmotionSource: true,
						safeDistance: 14,
						fleeDurationMs: 8000,
						jumpDistance: 4.5,
						landingRadius: 3,
						minDistanceGain: 1.5,
						heightBias: 1,
						pauseBetweenJumpsMs: 150,
						replanIntervalMs: 500,
						movespeed: 0.04,
						searchIntervalMs: 250,
						mincooldown: 500,
						maxcooldown: 1500,
						jumpAnimation: "jump",
						runAnimation: "run"
					},
					{
						// Wild spiders jump away from players who come too close (maxGeneration 0: domesticated ones do not).
						// Between flee sessions the vanilla fleeentity below keeps them running.
						code: "jumpingspiders.jumpflee",
						entityCodes: ["player"],
						priority: 2.5,
						maxGeneration: 0,
						whenNotInEmotionState: "aggressiveondamage",
						seekingRange: 6,
						safeDistance: 12,
						fleeDurationMs: 5000,
						jumpDistance: 4.5,
						landingRadius: 3,
						minDistanceGain: 1.5,
						heightBias: 1,
						pauseBetweenJumpsMs: 150,
						replanIntervalMs: 500,
						movespeed: 0.04,
						searchIntervalMs: 250,
						mincooldown: 2000,
						maxcooldown: 4000,
						jumpAnimation: "jump",
						runAnimation: "run"
					},
					{
						// Wild spiders run from players between flee jumps. maxGeneration 0: bred spiders do not flee.
						// tamingGenerations: vanilla shrinks flee range as generation grows toward this number; set high so
						// generation never weakens it.
						code: "fleeentity",
						entityCodes: ["player"],
						priority: 2.4,
						maxGeneration: 0,
						whenNotInEmotionState: "aggressiveondamage",
						tamingGenerations: 1000,
						movespeed: 0.04,
						seekingRange: 12,
						animation: "run",
						animationSpeed: 1.5
					},
					{
						// At night: go to a hammock (jumping up, walking first if needed), sleep until morning, hop out.
						// Sleeps on the spot when there is no usable hammock. Which hammock: design decisions 9 and 10
						// (home hammock for wild spiders, nearest free one for domesticated spiders).
						code: "jumpingspiders.sleep",
						priority: 2.0,
						whenNotInEmotionState: "aggressiveondamage|fleeondamage",
						// While asleep only tasks above this priority wake it (the attacker flee 2.8 and the attack 3.0
						// do, the player flee 2.5 does not).
						asleepPriorityForCancel: 2.6,
						checkIntervalMs: 1000,
						movespeed: 0.02,
						launchSpotSearchRadius: 6,
						maxLaunchSpotPlanChecks: 8,
						maxTravelAttempts: 3,
						travelTimeoutMs: 30000,
						windUpMinMs: 200,
						windUpMaxMs: 400,
						pauseBetweenJumpsMs: 300,
						turnSpeedDegPerSec: 360,
						leaveJumpRadius: 4,
						leaveHeightBias: 0,
						wakeOnHurt: true,
						// Wait before trying again after waking up or giving up (ms).
						mincooldown: 10000,
						maxcooldown: 20000,
						sleepAnimation: "sleep",
						windUpAnimation: "jumpwindup",
						jumpAnimation: "jump",
						walkAnimation: "walk"
					},
					{
						// Hunt prey and same-sex rival spiders, only while hungry (any kill makes it sated for
						// Config.SatedHoursAfterKill hours). retaliateAttacks false: being hit does not make this task chase
						// the attacker (the emotion states and the tasks above handle that).
						code: "jumpingspiders.jumpattack",
						entityCodes: ["hare-*", "raccoon-*", "chicken-*", "jumpingspider-adult-*"],
						priority: 1.6,
						whenNotInEmotionState: "fleeondamage",
						onlyWhenHungry: true,
						sameSexRivalsOnly: true,
						retaliateAttacks: false,
						tamingGenerations: 1000,
						seekingRange: 10,
						loseTargetRange: 16,
						pounceRange: 5,
						windUpMinMs: 500,
						windUpMaxMs: 1250,
						leadFactor: 0.5,
						hitReach: 0.4,
						damage: 3,
						damageTier: 0,
						damageType: "PiercingAttack",
						knockbackStrength: 0.5,
						movespeed: 0.02,
						maxApproachMs: 10000,
						repathIntervalMs: 1000,
						pounceCheckIntervalMs: 300,
						searchIntervalMs: 1000,
						turnSpeedDegPerSec: 360,
						mincooldown: 1500,
						maxcooldown: 3000,
						windUpAnimation: "jumpwindup",
						jumpAnimation: "jump",
						walkAnimation: "walk"
					},
					{
						// Only here so baited basket traps lure the spider. eatLooseItems false: it ignores meat on the ground.
						// Breeding saturation from eating is taken back by EntityBehaviorJumpingSpider.
						code: "seekfoodandeat",
						priority: 1.5,
						eatLooseItems: false,
						movespeed: 0.008,
						eatTime: 1.5,
						animation: "walk",
						mincooldownHours: 2,
						maxcooldownHours: 6
					},
					{
						code: "getoutofwater",
						priority: 1.4,
						movespeed: 0.015,
						animation: "walk",
						animationSpeed: 2
					},
					{
						// Domesticated spiders (minGeneration 1) hop around curiously, liking high spots. How often and how
						// many hops depends on the daily curiosity roll (lower at night); see AiTaskSpiderExplore.
						code: "jumpingspiders.explore",
						priority: 1.3,
						minGeneration: 1,
						decisionIntervalMs: 4000,
						exploreChance: 0.6,
						continueChance: 0.75,
						maxHops: 4,
						landingRadius: 6,
						heightBias: 2,
						territoryRadius: 12,
						pauseMinMs: 800,
						pauseMaxMs: 3000,
						windUpMinMs: 250,
						windUpMaxMs: 600,
						turnSpeedDegPerSec: 360,
						// Rest after an outing (ms).
						mincooldown: 8000,
						maxcooldown: 20000,
						windUpAnimation: "jumpwindup",
						jumpAnimation: "jump"
					},
					{
						// priorityForCancel 1.25 lets explore (1.3) interrupt a wander, but not the idle task below.
						code: "wander",
						priority: 1.0,
						priorityForCancel: 1.25,
						movespeed: 0.006,
						animation: "walk"
					},
					{
						code: "idle",
						priority: 0.9,
						priorityForCancel: 1.25,
						minduration: 5000,
						maxduration: 20000,
						mincooldown: 5000,
						maxcooldown: 30000
					},
					{
						code: "lookaround",
						priority: 0.5
					}
				]
			},
			{ code: "entitystatetags" }
		]
	},
	sounds: {
	}
}
